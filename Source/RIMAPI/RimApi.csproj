<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- RimWorld 1.7 (Waylith engine) runs on .NET 10; 1.5/1.6 run on Unity Mono -->
    <TargetFramework Condition="'$(Configuration)' != 'Release-1.7'">net472</TargetFramework>
    <TargetFramework Condition="'$(Configuration)' == 'Release-1.7'">net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>RIMAPI</RootNamespace>
    <AssemblyName>RIMAPI</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>1.12.0</Version>
  </PropertyGroup>

  <!-- Conditional properties for RimWorld 1.5 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release-1.5'">
    <OutputPath>..\..\1.5\Assemblies\</OutputPath>
    <DefineConstants>$(DefineConstants);RIMWORLD_1_5</DefineConstants>
  </PropertyGroup>

  <!-- Conditional properties for RimWorld 1.6 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release-1.6'">
    <OutputPath>..\..\1.6\Assemblies\</OutputPath>
    <DefineConstants>$(DefineConstants);RIMWORLD_1_6</DefineConstants>
  </PropertyGroup>

  <!-- Conditional properties for RimWorld 1.7 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release-1.7'">
    <OutputPath>..\..\1.7\Assemblies\</OutputPath>
    <DefineConstants>$(DefineConstants);RIMWORLD_1_7</DefineConstants>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- Ship Watson and its dependencies next to RIMAPI.dll -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Default output path for Debug -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>

  <!-- Embed git hash into AssemblyInformationalVersion as "1.9.0+<hash>" -->
  <Target Name="SetSourceRevisionId" BeforeTargets="AddSourceRevisionToInformationalVersion">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true"
          WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitRevisionRaw" />
    </Exec>
    <PropertyGroup>
      <SourceRevisionId Condition="'$(_GitRevisionRaw.Trim())' != ''">$(_GitRevisionRaw.Trim())</SourceRevisionId>
      <SourceRevisionId Condition="'$(_GitRevisionRaw.Trim())' == ''">unknown</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <!-- RimWorld 1.5 dependencies -->
    <PackageReference
      Include="Krafs.Rimworld.Ref"
      Version="1.5.4104"
      Condition="'$(Configuration)' == 'Release-1.5' OR '$(Configuration)' == 'Debug'"
    />

    <!-- RimWorld 1.6 dependencies -->
    <PackageReference
      Include="Krafs.Rimworld.Ref"
      Version="1.6.4518"
      Condition="'$(Configuration)' == 'Release-1.6'"
    />

    <!-- RimWorld 1.7 dependencies (Harmony 3 ships with the Harmony mod for 1.7) -->
    <PackageReference
      Include="Krafs.Rimworld.Ref"
      Version="1.7.4998-unstable"
      Condition="'$(Configuration)' == 'Release-1.7'"
    />
    <PackageReference
      Include="Lib.Harmony.Ref"
      Version="3.0.0-rc.4"
      Condition="'$(Configuration)' == 'Release-1.7'"
    />
    <!-- HTTP server for 1.7: HttpListener is HTTP.sys-backed on .NET 10/Windows and needs a URL ACL -->
    <PackageReference
      Include="Watson"
      Version="7.3.2"
      Condition="'$(Configuration)' == 'Release-1.7'"
    />

    <PackageReference
      Include="Lib.Harmony"
      Version="2.3.3"
      ExcludeAssets="runtime"
      Condition="'$(Configuration)' != 'Release-1.7'"
    />
    <Reference Include="Newtonsoft.Json, Version=13.0.0.0, Culture=neutral, PublicKeyToken=30ad4fe6b2a6aeed, processorArchitecture=MSIL">
      <HintPath>..\..\Libraries\Newtonsoft.Json.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>
</Project>
